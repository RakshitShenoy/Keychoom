# Copy to .env and edit. NEVER commit the real .env file.

APP_ENV=development            # development | test | production  (set production when deployed)
DATABASE_URL=sqlite:///./haunted_house.db
# CONTENT_DIR=                 # only to load game content from somewhere other than app/content
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
COOKIE_SECURE=false            # set true when served over HTTPS (Replit). Cookies are ALSO marked Secure
                               # automatically whenever a request arrives over HTTPS via the proxy.
COOKIE_SAMESITE=lax
HOST_COOKIE_NAME=hh_host
PLAYER_COOKIE_NAME=hh_player

# Global limits (the host's per-game settings must fall inside these)
MIN_TEAMS_LIMIT=3
MAX_TEAMS_LIMIT=25
MIN_PLAYERS_LIMIT=3
MAX_PLAYERS_LIMIT=10
MIN_BASE_DURATION_SECONDS=300
MAX_BASE_DURATION_SECONDS=14400
DEFAULT_BASE_DURATION_SECONDS=3600

# Hints (penalties are seconds, one per hint, comma separated; count must equal MAX_HINTS)
MAX_HINTS=4
HINT_PENALTIES_SECONDS=30,60,90,120

# Realtime / locking (used from Phase 2 onward)
OBJECT_LOCK_LEASE_SECONDS=75
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_HEARTBEAT_TIMEOUT_SECONDS=60

# WebSocket layer (Phase 3)
WS_SNAPSHOT_DEBOUNCE_SECONDS=0.05
WS_MAX_MESSAGE_BYTES=4096
WS_SEND_QUEUE_SIZE=200
WS_STATE_REQUEST_LIMIT=5
WS_STATE_REQUEST_WINDOW_SECONDS=10
WS_CHECK_ORIGIN=true
WS_ALLOWED_ORIGINS=            # extra allowed Origin hosts, comma separated (normally empty)

# Anonymous sessions
HOST_SESSION_TTL_HOURS=12
PLAYER_SESSION_TTL_HOURS=12

# Display names and game codes
MIN_DISPLAY_NAME_LENGTH=2
MAX_DISPLAY_NAME_LENGTH=24
GAME_CODE_LENGTH=6

# Team formation and lobby chat (Phase 2)
TEAM_CODE_LENGTH=4
TEAM_CODE_FAILURE_LIMIT=10
TEAM_CODE_FAILURE_WINDOW_SECONDS=60
CHAT_MAX_LENGTH=300
CHAT_HISTORY_LIMIT=50
CHAT_RATE_LIMIT_MESSAGES=5
CHAT_RATE_LIMIT_WINDOW_SECONDS=10

# Guess protection: failed game-code lookups allowed per client IP per window
JOIN_FAILURE_LIMIT=15
JOIN_FAILURE_WINDOW_SECONDS=60

# Gameplay and jumpscares
ANSWER_COOLDOWN_SECONDS=2        # pause after a wrong answer or wrong vault code (per team and object)
SWEEPER_INTERVAL_SECONDS=1       # how often stale locks, quiz timeouts and team deadlines are checked
JUMPSCARES_ENABLED=true
JUMPSCARES_PER_TEAM=3
JUMPSCARE_COOLDOWN_SECONDS=90
JUMPSCARE_DISPLAY_MS=5000

# Live-update tuning (defaults are right for up to 250 players; see README "Known limitations")
WS_SNAPSHOT_COST_PER_CONNECTION_SECONDS=0.008   # wait before a push grows with connected clients
WS_DASHBOARD_DEBOUNCE_SECONDS=0.25

# Database connection pool. Must stay at least as large as the ~40 web worker threads.
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT_SECONDS=30

# Replit / hosting. The start script (scripts/start.sh) binds 0.0.0.0 on $PORT (Replit sets it).
# PORT=8000
# LOG_LEVEL=info
